{
  "name": "askdare-spike-s7-store",
  "private": true,
  "type": "module",
  "description": "Spike S7: conversations stored outside OpenAI (Postgres prototype of a ConversationStore port).",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "typecheck": "tsc -p tsconfig.json",
    "contract": "node --env-file-if-exists=.env --test contract.test.ts",
    "turns": "node --env-file-if-exists=.env turns.ts",
    "probes": "node --env-file-if-exists=.env probes.ts"
  },
  "dependencies": {
    "openai": "7.56.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
