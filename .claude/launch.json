{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "starter",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd examples/starter && ASKDARE_GALLERY=${ASKDARE_GALLERY:-1} ASKDARE_ALLOWED_ORIGINS=${ASKDARE_ALLOWED_ORIGINS:-http://127.0.0.1:4000} exec ./node_modules/.bin/next dev --port 3000"
      ],
      "port": 3000
    },
    {
      "name": "host-page",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "APP_ORIGIN=http://localhost:3000 exec node e2e/servers/host-page.mjs"],
      "port": 4000,
      "url": "http://127.0.0.1:4000"
    }
  ]
}
