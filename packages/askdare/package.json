{
  "name": "@boldare/askdare",
  "version": "0.1.0-rc.1",
  "description": "Embeddable AI chatbot for Next.js, built on the official OpenAI SDK.",
  "license": "MIT",
  "author": {
    "name": "Boldare",
    "url": "https://www.boldare.com"
  },
  "homepage": "https://askdare.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boldare/askdare.git",
    "directory": "packages/askdare"
  },
  "bugs": "https://github.com/boldare/askdare/issues",
  "keywords": [
    "chatbot",
    "chat-widget",
    "ai",
    "assistant",
    "nextjs",
    "next.js",
    "widget",
    "embed",
    "openai",
    "responses-api",
    "rag",
    "openai-assistant",
    "assistants-api"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "askdare": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "llms.txt",
    "skills",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:assets": "vite build -c vite.widget.config.ts && vite build -c vite.loader.config.ts && node scripts/inline-assets.mjs",
    "build": "pnpm run build:assets && tsdown && node scripts/copy-docs.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only && node ../../scripts/check-dts-no-leak.mjs dist && node scripts/api-snapshot.mjs && tsc -p types-test",
    "api:update": "node scripts/api-snapshot.mjs --update",
    "docs:texts": "node scripts/docs-texts.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "marked": "18.1.2",
    "next": "^16.4.3",
    "preact": "10.29.8",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.3",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "jose": "^6.2.13",
    "openai": "^7.45.1"
  }
}
