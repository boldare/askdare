{
  "name": "@boldare/askdare-otel",
  "version": "0.1.0-rc.0",
  "description": "OpenTelemetry spans for @boldare/askdare chat turns, following the GenAI semantic conventions.",
  "license": "MIT",
  "author": {
    "name": "Boldare",
    "url": "https://www.boldare.com"
  },
  "homepage": "https://github.com/boldare/askdare/tree/main/packages/askdare-otel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boldare/askdare.git",
    "directory": "packages/askdare-otel"
  },
  "bugs": "https://github.com/boldare/askdare/issues",
  "keywords": [
    "askdare",
    "opentelemetry",
    "tracing",
    "genai"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown && node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only && node ../../scripts/check-dts-no-leak.mjs dist"
  },
  "peerDependencies": {
    "@boldare/askdare": "workspace:^",
    "@opentelemetry/api": "^1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@boldare/askdare": "workspace:^",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5"
  }
}
