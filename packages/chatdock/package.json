{
  "name": "@boldare/chatdock",
  "version": "0.0.0",
  "description": "Embeddable AI chatbot for Next.js, built on the official OpenAI SDK.",
  "license": "MIT",
  "author": "Boldare",
  "keywords": [
    "chatbot",
    "ai",
    "assistant",
    "nextjs",
    "widget",
    "embed",
    "openai",
    "responses-api"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:assets": "vite build -c vite.widget.config.ts && vite build -c vite.loader.config.ts && node scripts/inline-assets.mjs",
    "build": "pnpm run build:assets && tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only && node ../../scripts/check-dts-no-leak.mjs dist"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.3",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "openai": "^7.45.1"
  }
}
