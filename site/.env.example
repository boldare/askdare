# Copy to .env.local and fill in. Never commit real values.

# Key from a dedicated OpenAI project with a hard spend limit (ADR-0004).
OPENAI_API_KEY=

# At least 32 random characters: openssl rand -base64 32
CHAT_SECRET=
# Former secrets during rotation, comma-separated.
CHAT_SECRET_PREVIOUS=

# Optional: lets your site's backend sign visitors in with askdare('identify') (docs/identity.md).
# At least 32 random characters, different from CHAT_SECRET.
IDENTITY_SECRET=

# A current OpenAI model for your bot, and one for dictation.
ASKDARE_MODEL=gpt-6.1-terra
ASKDARE_TRANSCRIBE_MODEL=gpt-transcribe

# Sites allowed to embed the widget, comma-separated, e.g. https://www.example.com
ASKDARE_ALLOWED_ORIGINS=

# Vector store with the documents in knowledge/. `pnpm kb:sync` creates it and prints the ID.
KB_VECTOR_STORE_ID=
